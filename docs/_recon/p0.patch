+/**
+ * /valuation 首页的 mock 数据与纯函数工具。
+ *
+ * 用途：P0-T4 页面骨架阶段，在估值 API / 预计算表落地前先锁定前端契约与交互。
+ * 数据仅用于展示，不代表真实行情；接入估值 API 后整体替换，
+ * 但下方 `filterIndexRows` / 格式化 / 语气色函数保持为唯一入口，避免组件里再写一份。
+ */
+
+import type {
+  IndexCategory,
+  IndexQuoteRow,
+  MarketValuationCard,
+  ValuationLevel,
+} from "./valuation-types";
