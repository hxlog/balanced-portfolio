@@ -0,0 +1,58 @@
+# -*- coding: utf-8 -*-
+"""按编号应用单个迁移（幂等，显式事务 + statement_timeout）。
+
+用法：
+    python scripts/apply_migration.py ddl/51_quote_adjust_dimension.sql
+    python scripts/apply_migration.py ddl/52_index_valuation_domain.sql --db postgres
+"""
+from __future__ import annotations
+
+import argparse
+import pathlib
+import re
+import sys
+import time
+
+import psycopg
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+
+
+def load_env() -> dict:
+    env = {}
+    for line in (ROOT / ".env").read_text(encoding="utf-8").splitlines():
+        m = re.match(r"^([A-Z0-9_]+)=(.*)$", line)
+        if m:
+            env[m.group(1)] = m.group(2).strip().strip('"')
+    return env
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("file")
+    parser.add_argument("--db", default="postgres")
+    parser.add_argument("--host", default="81.71.158.239")
+    parser.add_argument("--timeout-ms", type=int, default=600_000)
+    args = parser.parse_args()
+
+    env = load_env()
+    sql = (ROOT / args.file).read_text(encoding="utf-8")
+    started = time.perf_counter()
+    with psycopg.connect(
+        host=args.host,
+        port=int(env.get("PGPORT", "5432")),
+        dbname=args.db,
+        user=env.get("PGUSER", "postgres"),
+        password=env.get("PGPASSWORD", ""),
+        connect_timeout=15,
+        autocommit=False,
+    ) as conn, conn.cursor() as cur:
+        cur.execute("select set_config('statement_timeout', %s, true)", (str(args.timeout_ms),))
+        cur.execute(sql, prepare=False)
+        conn.commit()
+    print(f"[ok] {args.file} applied in {time.perf_counter() - started:.1f}s")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/test_migrations.py b/scripts/test_migrations.py
new file mode 100644
index 0000000..4d4dfc4
--- /dev/null
+++ b/scripts/test_migrations.py
@@ -0,0 +1,92 @@
+# -*- coding: utf-8 -*-
+"""迁移测试脚手架：在临时库上验证 schema.sql + ddl/NN_*.sql 的正确性与幂等性。
+
+用法：
+    python scripts/test_migrations.py            # 重建临时库并全量验证
+    python scripts/test_migrations.py --keep     # 保留临时库
+
+安全：只操作 bp_mig_test 临时库；不触碰生产库任何数据。
+"""
+import argparse
+import pathlib
+import re
+import sys
+
+import psycopg
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+TEST_DB = "bp_mig_test"
+
+
+def load_env() -> dict:
+    env = {}
+    for line in (ROOT / ".env").read_text(encoding="utf-8").splitlines():
+        m = re.match(r"^([A-Z0-9_]+)=(.*)$", line.strip())
+        if m:
+            env[m.group(1)] = m.group(2).strip().strip('"')
+    return env
+
+
+def connect(env: dict, db: str, autocommit: bool = True):
+    return psycopg.connect(
+        host="81.71.158.239",
+        port=5432,
+        user=env.get("PGUSER", "postgres"),
+        password=env.get("PGPASSWORD", ""),
+        dbname=db,
+        connect_timeout=15,
+        autocommit=autocommit,
+    )
+
+
+def recreate_db(env: dict) -> None:
+    with connect(env, "postgres") as conn, conn.cursor() as cur:
+        cur.execute("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=%s", (TEST_DB,))
+        cur.execute(f"DROP DATABASE IF EXISTS {TEST_DB}")
+        cur.execute(f"CREATE DATABASE {TEST_DB}")
+
+
+def apply_sql(cur, path: pathlib.Path, label: str) -> None:
+    sql = path.read_text(encoding="utf-8")
+    cur.execute(sql, prepare=False)
+    print(f"  [ok] {label}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--keep", action="store_true")
+    args = parser.parse_args()
+    env = load_env()
+
+    print("== 重建临时库 ==")
+    recreate_db(env)
+
+    with connect(env, TEST_DB) as conn, conn.cursor() as cur:
+        print("== 基线 ==")
+        apply_sql(cur, ROOT / "ddl" / "schema.sql", "schema.sql")
+
+        migrations = sorted((ROOT / "ddl").glob("5[0-9]_*.sql"))
+        if not migrations:
+            print("  (无 5x 迁移)")
+        for mig in migrations:
+            print(f"== {mig.name} (x3 幂等) ==")
+            for i in (1, 2, 3):
+                try:
+                    apply_sql(cur, mig, f"第 {i} 次")
+                except Exception as exc:  # noqa: BLE001
+                    print(f"  [FAIL] {mig.name} 第 {i} 次: {type(exc).__name__}: {str(exc)[:300]}")
+                    return 1
+
+        cur.execute("SELECT count(*) FROM information_schema.tables WHERE table_schema='public'")
+        print(f"== 完成：public 表 {cur.fetchone()[0]} 张 ==")
+
+    if not args.keep:
+        with connect(env, "postgres") as conn, conn.cursor() as cur:
+            cur.execute("SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=%s", (TEST_DB,))
+            cur.execute(f"DROP DATABASE IF EXISTS {TEST_DB}")
+        print("临时库已清理")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
