+/** 估值首页：指数列表（行情 + 最新主口径估值 + PE/PB 分位）。
+ *
+ * 后端只读预计算表，请求路径永不计算。失效：估值采集任务落库后
+ * POST /api/revalidate/valuation，或等 cacheLife("hours") TTL 兜底。
+ * 失败时 throw（不缓存 null），页面 catch 后回退示例数据。 */
+export async function getCachedValuationIndices(
+  limit = 600,
