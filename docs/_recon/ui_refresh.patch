+              <Pulse className="mx-auto h-[220px] w-[220px] rounded-full" />
+            </div>
+          ) : rows.length === 0 ? (
+            <div className="rounded-lg border border-dashed border-border bg-bg-subtle/40 px-4 py-10 text-center text-sm text-muted-foreground">
