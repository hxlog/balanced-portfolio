+import { describe, expect, it } from "vitest";
+import {
+  basketSkyColor,
+  basketWeightRows,
+  formatPct,
+  formatRatio,
+  formatSignedPct,
+  normalizeRiskBudget,
+} from "./basket-format";
+
+describe("normalizeRiskBudget", () => {
+  it("normalizes relative budgets to exactly 1", () => {
+    const out = normalizeRiskBudget({ a: 1, b: 2, c: 1 });
+    expect(out.a).toBeCloseTo(0.25, 12);
+    expect(out.b).toBeCloseTo(0.5, 12);
+    expect(out.c).toBeCloseTo(0.25, 12);
+    expect(Object.values(out).reduce((s, v) => s + v, 0)).toBeCloseTo(1, 12);
+  });
+
+  it("falls back to equal weights when every value is zero/invalid", () => {
+    const out = normalizeRiskBudget({ a: 0, b: -3, c: Number.NaN });
+    expect(out.a).toBeCloseTo(1 / 3, 12);
+    expect(out.b).toBeCloseTo(1 / 3, 12);
+    expect(out.c).toBeCloseTo(1 / 3, 12);
+  });
+
+  it("ignores non-positive and non-finite values when others are valid", () => {
+    const out = normalizeRiskBudget({ a: 2, b: 0, c: Number.POSITIVE_INFINITY });
+    expect(out.a).toBe(1);
+    expect(out.b).toBe(0);
+    expect(out.c).toBe(0);
+  });
+
+  it("returns an empty map for empty input", () => {
+    expect(normalizeRiskBudget({})).toEqual({});
+  });
+});
+
+describe("basketWeightRows", () => {
+  it("sorts descending, maps names and assigns deterministic sky colors", () => {
+    const names = new Map([
+      ["a@stock_sina", "甲"],
+      ["b@etf_em", "乙"],
+    ]);
+    const rows = basketWeightRows(
+      [
+        { symbol: "a", source: "stock_sina", weight: 0.2 },
+        { symbol: "b", source: "etf_em", weight: 0.8 },
+        { symbol: "c", source: "etf_em", weight: 0 },
+      ],
+      names,
+      false,
+    );
+    expect(rows.map((r) => r.symbol)).toEqual(["b", "a", "c"]);
+    expect(rows[0].name).toBe("乙");
+    expect(rows[1].name).toBe("甲");
+    expect(rows[2].name).toBe("c");
+    expect(rows[0].color).toBe(basketSkyColor(0, false));
+    expect(rows[1].color).toBe(basketSkyColor(1, false));
+  });
+
+  it("clamps negative/non-finite weights to zero", () => {
+    const rows = basketWeightRows(
+      [
+        { symbol: "a", source: "x", weight: -1 },
+        { symbol: "b", source: "x", weight: Number.NaN },
+      ],
+      new Map(),
+      true,
+    );
+    expect(rows.every((r) => r.weight === 0)).toBe(true);
+  });
+});
+
+describe("number formatting", () => {
+  it("formats percentages and avoids negative zero", () => {
+    expect(formatPct(0.1234)).toBe("12.3%");
+    expect(formatPct(-0.000001)).toBe("0.0%");
+    expect(formatPct(Number.NaN)).toBe("—");
+  });
+
+  it("formats signed percentages for directional metrics", () => {
+    expect(formatSignedPct(0.05)).toBe("+5.0%");
+    expect(formatSignedPct(-0.05)).toBe("-5.0%");
+    expect(formatSignedPct(0)).toBe("0.0%");
+  });
+
+  it("formats ratios", () => {
+    expect(formatRatio(1.234)).toBe("1.23");
+    expect(formatRatio(null)).toBe("—");
+  });
+});
diff --git a/web/lib/basket-format.ts b/web/lib/basket-format.ts
new file mode 100644
index 0000000..ab26cff
--- /dev/null
+++ b/web/lib/basket-format.ts
@@ -0,0 +1,118 @@
+/** 一篮子模式的权重排序、配色与数字格式（纯函数，便于单测）。 */
+
+import { basketKey, type BasketWeight } from "./basket-types";
+
+export function formatPct(
+  value: number | null | undefined,
+  digits = 1,
+): string {
+  if (value == null || !Number.isFinite(value)) return "—";
+  const epsilon = 0.5 * 10 ** -digits;
+  const safe = Math.abs(value) < epsilon ? 0 : value;
+  return `${(safe * 100).toFixed(digits)}%`;
+}
+
+export function formatSignedPct(
+  value: number | null | undefined,
+  digits = 1,
+): string {
+  if (value == null || !Number.isFinite(value)) return "—";
+  const text = formatPct(value, digits);
+  return value > 0 ? `+${text}` : text;
+}
+
+export function formatRatio(
+  value: number | null | undefined,
+  digits = 2,
+): string {
+  if (value == null || !Number.isFinite(value)) return "—";
+  return value.toFixed(digits);
+}
+
+/**
+ * 把用户输入的风险预算（相对权重）归一化到合计 = 1。
+ * 负数/NaN/Infinity 按 0 处理；全部为 0 时退化为等权。
+ * 空输入返回空对象（调用方据此决定是否携带 risk_budget）。
+ */
+export function normalizeRiskBudget(
+  raw: Record<string, number>,
+): Record<string, number> {
+  const keys = Object.keys(raw);
+  if (keys.length === 0) return {};
+
+  const clean: Record<string, number> = {};
+  let total = 0;
+  for (const key of keys) {
+    const value = Number(raw[key]);
+    const weight = Number.isFinite(value) && value > 0 ? value : 0;
+    clean[key] = weight;
+    total += weight;
+  }
+
+  if (total <= 0) {
+    const equal = 1 / keys.length;
+    for (const key of keys) clean[key] = equal;
+  } else {
+    for (const key of keys) clean[key] /= total;
+  }
+
+  // 让最大项吸收浮点残差，保证后端 `abs(sum - 1) <= 1e-6` 校验恒过。
+  const last = keys[keys.length - 1];
+  const sum = keys.reduce((acc, key) => acc + clean[key], 0);
+  clean[last] += 1 - sum;
+  return clean;
+}
+
+/**
+ * 权重条/甜甜圈共用的 sky 色阶。
+ * 明暗两套都保持在 195–205° 色相（sky/cyan），通过饱和度与明度区分资产。
+ */
+export function basketSkyColor(index: number, isDark: boolean): string {
+  const i = Math.max(0, Math.floor(index));
+  const hue = 195 + (i % 6) * 2; // 195,197,199,201,203,205
+  const saturation = 76 + (Math.floor(i / 6) % 3) * 8; // 76/84/92
+  const lightness = isDark
+    ? 48 + (i % 4) * 6 // 48–66
+    : 36 + (i % 4) * 8; // 36–60
+  return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
+}
+
+export interface BasketWeightRow {
+  key: string;
+  name: string;
+  symbol: string;
+  source: string;
+  weight: number;
+  color: string;
+}
+
+/**
+ * 权重按降序排列并绑定颜色。名称缺失时回退 symbol；
+ * 0 权重仍保留（让「未激活资产」在列表中可见），donut 侧自行过滤。
+ */
+export function basketWeightRows(
+  weights: BasketWeight[],
+  nameByKey: ReadonlyMap<string, string>,
+  isDark: boolean,
+): BasketWeightRow[] {
+  return weights
+    .map((row) => {
+      const key = basketKey(row.symbol, row.source);
+      const value = Number(row.weight);
+      return {
+        key,
+        name: nameByKey.get(key) ?? row.symbol,
+        symbol: row.symbol,
+        source: row.source,
+        weight: Number.isFinite(value) ? Math.max(0, value) : 0,
+      };
+    })
+    .sort(
+      (a, b) =>
+        b.weight - a.weight || a.name.localeCompare(b.name, "zh-CN"),
+    )
+    .map((row, index) => ({
+      ...row,
+      color: basketSkyColor(index, isDark),
+    }));
+}
