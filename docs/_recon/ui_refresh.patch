+              x: 0,
+              y: 0,
+              x2: 0,
+              y2: 1,
+              colorStops: [
+                { offset: 0, color: withAlpha(theme.palette[0], 0.3) },
+                { offset: 1, color: withAlpha(theme.palette[0], 0) },
