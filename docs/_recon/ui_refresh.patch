+        className={cn("relative h-2 rounded-full bg-muted", barClassName)}
+        role="img"
+        aria-label={
+          pct == null
+            ? `${label ?? "分位"}样本不足`
+            : `${label ?? "分位"} ${pct.toFixed(1)}%`
+        }
+      >
