+
+
+# ---------------------------------------------------------------------
+# 超管端点
+# ---------------------------------------------------------------------
+def test_admin_endpoints_create_list_and_revoke(fixed_db):
+    conn = fixed_db
+    admin = auth.UserContext(None, "admin@example.com", "admin", True)
+
