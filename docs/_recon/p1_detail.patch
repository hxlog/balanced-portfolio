+import type { Metadata } from "next";
+import { Suspense } from "react";
+import { connection } from "next/server";
+import {
+  findPercentile,
+  mapValuationDetail,
+  mapValuationHistory,
+} from "@/lib/valuation-detail-api-map";
+import {
+  getCachedValuationDetail,
+  getCachedValuationHistory,
+} from "@/lib/valuation-detail-data";
+import type {
+  ValuationDetailData,
+  ValuationHistoryData,
+} from "@/lib/valuation-detail-types";
+import { ValuationDetailClient } from "./ValuationDetailClient";
+import { ValuationDetailSkeleton } from "./ValuationDetailSkeleton";
+
+interface ValuationDetailPageProps {
+  params: Promise<{ code: string }>;
+}
+
+/** 动态 metadata：指数名 + PE + PE 分位；后端不可用时回退通用标题。 */
+export async function generateMetadata({
+  params,
+}: ValuationDetailPageProps): Promise<Metadata> {
+  const { code } = await params;
+
+  try {
+    const response = await getCachedValuationDetail(code);
+    const detail = mapValuationDetail(response.data);
+    if (!detail) throw new Error("invalid valuation detail payload");
+
+    const stats = findPercentile(detail.percentiles, "pe_ttm");
+    const peText =
+      detail.pe_ttm != null ? `PE ${detail.pe_ttm.toFixed(2)}` : "PE —";
+    const pctText =
+      stats?.pct != null && stats.sample_size >= 120
+        ? `PE 分位 ${stats.pct.toFixed(2)}%`
+        : "PE 分位样本不足";
+    const title = `${detail.name}（${detail.index_code}）估值 — ${peText} · ${pctText}`;
+    const description = `${detail.name} 指数估值详情：PE/PB、股息率、风险溢价与近 5 年历史分位。${peText}，${pctText}。数据截至 ${detail.trade_date ?? "—"}。`;
+    const canonical = `/valuation/${encodeURIComponent(detail.index_code)}`;
+
+    return {
+      title,
+      description,
+      alternates: { canonical },
+      openGraph: {
+        title: `${title} | Balanced Portfolio`,
+        description,
+        url: canonical,
+        type: "article",
+      },
+    };
+  } catch {
+    const canonical = `/valuation/${encodeURIComponent(code)}`;
+    return {
+      title: `指数估值详情（${code}）`,
+      description: `指数 ${code} 的 PE/PB、股息率与历史分位详情。`,
+      alternates: { canonical },
+      openGraph: {
+        title: "指数估值详情 | Balanced Portfolio",
+        description: `指数 ${code} 的 PE/PB、股息率与历史分位详情。`,
+        url: canonical,
+        type: "article",
+      },
+    };
+  }
+}
+
+/** 数据层：显式请求期取数；任一接口失败时交给客户端展示错误态/空态。 */
+async function ValuationDetailData({ code }: { code: string }) {
+  // PPR：显式声明请求期数据，避免构建期预渲染去连后端。
+  await connection();
+
+  let detail: ValuationDetailData | null = null;
+  let history: ValuationHistoryData | null = null;
+
+  try {
+    const [detailResult, historyResult] = await Promise.allSettled([
+      getCachedValuationDetail(code),
+      getCachedValuationHistory(code),
+    ]);
+
+    if (detailResult.status === "fulfilled") {
+      detail = mapValuationDetail(detailResult.value.data);
+    } else {
+      console.error("valuation detail SSR fetch failed:", detailResult.reason);
+    }
+
+    if (historyResult.status === "fulfilled") {
+      history = mapValuationHistory(historyResult.value.data);
+    } else {
+      console.error("valuation history SSR fetch failed:", historyResult.reason);
+    }
+  } catch (error) {
+    console.error("valuation detail SSR failed:", error);
+  }
+
+  return (
+    <ValuationDetailClient code={code} detail={detail} history={history} />
+  );
+}
+
+export default async function ValuationDetailPage({
+  params,
+}: ValuationDetailPageProps) {
+  const { code } = await params;
+
+  return (
+    <Suspense fallback={<ValuationDetailSkeleton />}>
+      <ValuationDetailData code={code} />
+    </Suspense>
+  );
+}
diff --git a/web/lib/valuation-detail-api-map.ts b/web/lib/valuation-detail-api-map.ts
new file mode 100644
index 0000000..3d632ed
--- /dev/null
+++ b/web/lib/valuation-detail-api-map.ts
@@ -0,0 +1,205 @@
+/**
+ * 后端 `/api/valuation/{code}` 与 `/history` 响应 -> 详情页类型。
+ *
+ * 与 `valuation-api-map.ts` 同一定位：字段口径在这里收口，组件只消费映射后的
+ * 驼峰/语义化结构。所有数值走 `num()`，兼容 DB 原生 Decimal/字符串；NaN/Inf 一律
+ * 归一为 null，展示层显示「—」。
+ */
+
+import type { IndexCategory, ValuationLevel } from "./valuation-types";
+import type {
+  DetailConstituent,
+  DetailPercentile,
+  DetailTrackerFund,
+  PercentileSummary,
+  ValuationDetailData,
+  ValuationHistoryData,
+  ValuationHistoryPoint,
+} from "./valuation-detail-types";
+
+const CATEGORIES: ReadonlySet<string> = new Set(["宽基", "行业", "主题", "策略", "其他"]);
+const LEVELS: ReadonlySet<string> = new Set(["低估", "中性", "高估"]);
+
+function num(value: unknown): number | null {
+  if (typeof value === "number" && Number.isFinite(value)) return value;
+  if (
+    typeof value === "string" &&
+    value.trim() !== "" &&
+    Number.isFinite(Number(value))
+  ) {
+    return Number(value);
+  }
+  return null;
+}
+
+function str(value: unknown): string | null {
+  return typeof value === "string" && value !== "" ? value : null;
+}
+
+/** 只保留日期部分，避免后端返回 datetime 时把时间串进页面。 */
+function dateStr(value: unknown): string | null {
+  const text = str(value);
+  return text ? text.slice(0, 10) : null;
+}
+
+function asCategory(value: unknown): IndexCategory {
+  const text = typeof value === "string" ? value : "";
+  return (CATEGORIES.has(text) ? text : "其他") as IndexCategory;
+}
+
+function asLevel(value: unknown): ValuationLevel | null {
+  const text = typeof value === "string" ? value : "";
+  return (LEVELS.has(text) ? text : null) as ValuationLevel | null;
+}
+
+function mapConstituent(raw: unknown): DetailConstituent | null {
+  if (!raw || typeof raw !== "object") return null;
+  const item = raw as Record<string, unknown>;
+  const stockCode = str(item.stock_code);
+  if (!stockCode) return null;
+  return {
+    stock_code: stockCode,
+    name: str(item.name) ?? stockCode,
+    industry_l1: str(item.industry_l1),
+    weight: num(item.weight),
+    rank: num(item.rank),
+    effective_date: dateStr(item.effective_date),
+  };
+}
+
+function mapTrackerFund(raw: unknown): DetailTrackerFund | null {
+  if (!raw || typeof raw !== "object") return null;
+  const item = raw as Record<string, unknown>;
+  const fundCode = str(item.fund_code);
+  if (!fundCode) return null;
+  return {
+    fund_code: fundCode,
+    name: str(item.name) ?? fundCode,
+    company_name: str(item.company_name),
+    risk_grade: str(item.risk_grade),
+    aum: num(item.aum),
+    trade_date: dateStr(item.trade_date),
+  };
+}
+
+/**
+ * 分位统计映射。
+ *
+ * history 的 `stats` 直接来自 `bp_index_percentile` 行，DB 列名是 `min_value` /
+ * `max_value`，而契约文档写的是 `min` / `max`；这里两者都兼容。
+ */
+export function mapPercentileSummary(raw: unknown): PercentileSummary | null {
+  if (!raw || typeof raw !== "object") return null;
+  const item = raw as Record<string, unknown>;
+  return {
+    pct: num(item.pct),
+    mean: num(item.mean),
+    sd: num(item.sd),
+    p20: num(item.p20),
+    p50: num(item.p50),
+    p80: num(item.p80),
+    min: num(item.min) ?? num(item.min_value),
+    max: num(item.max) ?? num(item.max_value),
+    sample_size: Math.max(0, Math.trunc(num(item.sample_size) ?? 0)),
+    reason: str(item.reason),
+  };
+}
+
+function mapDetailPercentile(raw: unknown): DetailPercentile | null {
+  if (!raw || typeof raw !== "object") return null;
+  const item = raw as Record<string, unknown>;
+  const summary = mapPercentileSummary(item);
+  const metric = str(item.metric);
+  if (!summary || !metric) return null;
+  return {
+    ...summary,
+    metric,
+    window_key: str(item.window_key) ?? "",
+  };
+}
+
+/** 详情响应 `data` -> `ValuationDetailData`；缺少指数代码时返回 null（按错误态处理）。 */
+export function mapValuationDetail(
+  raw: Record<string, unknown> | null | undefined,
+): ValuationDetailData | null {
+  if (!raw || typeof raw !== "object") return null;
+  const code = str(raw.index_code);
+  if (!code) return null;
+
+  const constituents = Array.isArray(raw.constituents)
+    ? raw.constituents
+        .map(mapConstituent)
+        .filter((item): item is DetailConstituent => item !== null)
+    : [];
+  const trackerFunds = Array.isArray(raw.tracker_funds)
+    ? raw.tracker_funds
+        .map(mapTrackerFund)
+        .filter((item): item is DetailTrackerFund => item !== null)
+    : [];
+  const percentiles = Array.isArray(raw.percentiles)
+    ? raw.percentiles
+        .map(mapDetailPercentile)
+        .filter((item): item is DetailPercentile => item !== null)
+    : [];
+
+  return {
+    index_code: code,
+    name: str(raw.name) ?? code,
+    market: str(raw.market),
+    index_type: asCategory(raw.index_type),
+    publisher: str(raw.publisher),
+    base_date: dateStr(raw.base_date),
+    base_point: num(raw.base_point),
+    income_method: str(raw.income_method),
+    intro: str(raw.intro),
+    trade_date: dateStr(raw.trade_date),
+    pe_ttm: num(raw.pe_ttm),
+    pb: num(raw.pb),
+    dividend_yield_ttm: num(raw.dividend_yield_ttm),
+    erp: num(raw.erp),
+    roe_ttm: num(raw.roe_ttm),
+    bond10y: num(raw.bond10y),
+    level_pe: asLevel(raw.level_pe),
+    level_pb: asLevel(raw.level_pb),
+    level_dividend: asLevel(raw.level_dividend),
+    constituents,
+    tracker_funds: trackerFunds,
+    percentiles,
+  };
+}
+
+function mapHistoryPoint(raw: unknown): ValuationHistoryPoint | null {
+  if (!raw || typeof raw !== "object") return null;
+  const item = raw as Record<string, unknown>;
+  const date = dateStr(item.trade_date);
+  const value = num(item.value);
+  if (!date || value == null) return null;
+  return { trade_date: date, value };
+}
+
+/** history 响应 `data` -> `ValuationHistoryData`；按日期升序。 */
+export function mapValuationHistory(
+  raw: Record<string, unknown> | null | undefined,
+): ValuationHistoryData {
+  const item = raw && typeof raw === "object" ? raw : {};
+  const series = Array.isArray(item.series)
+    ? item.series
+        .map(mapHistoryPoint)
+        .filter((point): point is ValuationHistoryPoint => point !== null)
+    : [];
+  series.sort((a, b) => a.trade_date.localeCompare(b.trade_date));
+  return { series, stats: mapPercentileSummary(item.stats) };
+}
+
+/** 从详情 `percentiles[]` 精确取某个 metric + window 的统计。 */
+export function findPercentile(
+  percentiles: readonly DetailPercentile[],
+  metric: string,
+  windowKey = "5y",
+): DetailPercentile | null {
+  return (
+    percentiles.find(
+      (item) => item.metric === metric && item.window_key === windowKey,
+    ) ?? null
+  );
+}
diff --git a/web/lib/valuation-detail-data.ts b/web/lib/valuation-detail-data.ts
new file mode 100644
index 0000000..456d405
--- /dev/null
+++ b/web/lib/valuation-detail-data.ts
@@ -0,0 +1,53 @@
+/**
+ * `/valuation/[code]` 的服务端数据层。
+ *
+ * 与 `cached-data.ts` 同一形态：`"use cache"` + `cacheLife("hours")` +
+ * `cacheTag("valuation")`。后端重算落库后可通过 `POST /api/revalidate/valuation`
+ * 失效同一个 tag；失败时 throw（不缓存 null），由页面 catch 后展示错误态。
+ *
+ * 请求路径只读后端预计算表，不在 Next 侧做任何计算。
+ */
+
+import { cacheLife, cacheTag } from "next/cache";
+import { apiBase } from "./session-server";
+
+/** 后端统一响应信封。 */
+export interface ValuationEnvelope {
+  data: Record<string, unknown>;
+  meta: Record<string, unknown>;
+}
+
+async function serverFetch<T>(path: string): Promise<T> {
+  const res = await fetch(`${apiBase()}${path}`);
+  if (!res.ok) {
+    throw new Error(`API ${path}: ${res.status}`);
+  }
+  return res.json() as Promise<T>;
+}
+
+/** 指数详情（画像 + 最新估值 + 分位 + 成分 + 跟踪基金）。 */
+export async function getCachedValuationDetail(
+  code: string,
+): Promise<ValuationEnvelope> {
+  "use cache";
+  cacheLife("hours");
+  cacheTag("valuation");
+  return await serverFetch<ValuationEnvelope>(
+    `/api/valuation/${encodeURIComponent(code)}`,
+  );
+}
+
+/** 估值历史序列 + 区间统计。 */
+export async function getCachedValuationHistory(
+  code: string,
+  metric = "pe_ttm",
+  windowKey = "5y",
+): Promise<ValuationEnvelope> {
+  "use cache";
+  cacheLife("hours");
+  cacheTag("valuation");
+  const params = new URLSearchParams({ metric, window: windowKey });
+  return await serverFetch<ValuationEnvelope>(
+    `/api/valuation/${encodeURIComponent(code)}/history?${params.toString()}`,
+  );
+}
diff --git a/web/lib/valuation-detail-format.ts b/web/lib/valuation-detail-format.ts
new file mode 100644
index 0000000..9ebcc85
--- /dev/null
+++ b/web/lib/valuation-detail-format.ts
@@ -0,0 +1,78 @@
+/**
+ * `/valuation/[code]` 的展示格式化与语气色。
+ *
+ * 基础数字/百分比格式化复用 `valuation-mock.ts`（全站唯一入口），这里只补充
+ * 详情页特有的「亿元」「0~100 分位」「样本是否可用」三类逻辑。
+ */
+
+import type { PercentileSummary } from "./valuation-detail-types";
+import {
+  EMPTY_DISPLAY,
+  formatNumber,
+  formatPlainPct,
+  formatSignedPct,
+} from "./valuation-mock";
+
+export { EMPTY_DISPLAY, formatNumber, formatPlainPct, formatSignedPct };
+
+/** 后端分位样本门槛：有效样本 <120 时不输出 pct。 */
+export const MIN_PERCENTILE_SAMPLE = 120;
+
+/** 元 -> 亿元，保留 2 位小数；缺失显示「—」。 */
+export function formatAumYi(value: number | null | undefined): string {
+  if (value == null || !Number.isFinite(value)) return EMPTY_DISPLAY;
+  return (value / 1e8).toLocaleString("zh-CN", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+}
+
+/** 0~100 分位 -> 百分比文本（与 DB/API 同口径，不再 ×100）。 */
+export function formatPercentileValue(
+  value: number | null | undefined,
+  digits = 2,
+): string {
+  if (value == null || !Number.isFinite(value)) return EMPTY_DISPLAY;
+  return `${value.toFixed(digits)}%`;
+}
+
+/**
+ * 分位语气色：低分位=便宜=success，中间=warning，高分位=高估=destructive。
+ * 入参为 0~100（API 口径），与涨跌色 text-up/text-down 解耦。
+ */
+export function percentileTone(value: number | null | undefined): string {
+  if (value == null || !Number.isFinite(value)) return "text-muted-foreground";
+  if (value <= 30) return "text-success";
+  if (value >= 70) return "text-destructive";
+  return "text-warning";
+}
+
+/** 分位 -> 「低估 / 中性 / 高估」；样本不足返回 null。 */
+export function percentileLabel(
+  value: number | null | undefined,
+): "低估" | "中性" | "高估" | null {
+  if (value == null || !Number.isFinite(value)) return null;
+  if (value <= 30) return "低估";
+  if (value >= 70) return "高估";
+  return "中性";
+}
+
+/** 分位统计是否可用（pct 非空且样本 ≥120）。 */
+export function hasUsablePercentile(
+  stats: PercentileSummary | null | undefined,
+): stats is PercentileSummary & { pct: number } {
+  return Boolean(
+    stats &&
+      stats.pct != null &&
+      Number.isFinite(stats.pct) &&
+      stats.sample_size >= MIN_PERCENTILE_SAMPLE,
+  );
+}
+
+/** 分位不可用时的说明文案。 */
+export function percentileUnavailableText(
+  stats: PercentileSummary | null | undefined,
+): string {
+  if (!stats) return "暂无分位统计";
+  return `样本不足（${formatNumber(stats.sample_size, 0)} < ${MIN_PERCENTILE_SAMPLE}）`;
+}
diff --git a/web/lib/valuation-detail-types.ts b/web/lib/valuation-detail-types.ts
new file mode 100644
index 0000000..493eb5e
--- /dev/null
+++ b/web/lib/valuation-detail-types.ts
@@ -0,0 +1,100 @@
+/**
+ * `/valuation/[code]` 指数详情页的前端类型。
+ *
+ * 单位约定沿用 `valuation-types.ts`：
+ * - `pct` 为 0~100 百分数（与 DB/API 一致），展示层直接加 `%`。
+ * - 股息率 / 风险溢价 / ROE 为「百分数点」，展示层不再 ×100。
+ * - 成分股权重 `weight` 为 0~100 百分数点。
+ * - 跟踪基金 `aum` 为元；展示层统一除以 1e8 转「亿元」。
+ * - `null` 表示缺失或样本不足（<120），不得用 0 填充。
+ */
+
+import type { IndexCategory, ValuationLevel } from "./valuation-types";
+
+/** 最新生效日的成分股。 */
+export interface DetailConstituent {
+  stock_code: string;
+  name: string;
+  industry_l1: string | null;
+  /** 权重（百分数点，0~100）。 */
+  weight: number | null;
+  rank: number | null;
+  effective_date: string | null;
+}
+
+/** 最新交易日的跟踪基金。 */
+export interface DetailTrackerFund {
+  fund_code: string;
+  name: string;
+  company_name: string | null;
+  risk_grade: string | null;
+  /** 规模（元）；展示层除以 1e8 转亿元。 */
+  aum: number | null;
+  trade_date: string | null;
+}
+
+/** 分位窗口统计（详情 `percentiles[]` 与 history `stats` 共用）。 */
+export interface PercentileSummary {
+  /** 当前值在窗口内的分位，0~100；样本不足时为 null。 */
+  pct: number | null;
+  mean: number | null;
+  sd: number | null;
+  p20: number | null;
+  p50: number | null;
+  p80: number | null;
+  min: number | null;
+  max: number | null;
+  /** 有效样本数（不含 null）。 */
+  sample_size: number;
+  /** 后端样本不足时给 `insufficient_sample`。 */
+  reason?: string | null;
+}
+
+/** 详情接口 `percentiles` 数组的一行。 */
+export interface DetailPercentile extends PercentileSummary {
+  metric: string;
+  window_key: string;
+}
+
+/** 详情接口映射后的完整快照。 */
+export interface ValuationDetailData {
+  index_code: string;
+  name: string;
+  market: string | null;
+  index_type: IndexCategory;
+  publisher: string | null;
+  base_date: string | null;
+  base_point: number | null;
+  income_method: string | null;
+  intro: string | null;
+  trade_date: string | null;
+  pe_ttm: number | null;
+  pb: number | null;
+  /** 股息率 TTM（百分数点）。 */
+  dividend_yield_ttm: number | null;
+  /** 风险溢价（百分数点）。 */
+  erp: number | null;
+  /** ROE TTM（百分数点）。 */
+  roe_ttm: number | null;
+  /** 十年期国债到期收益率（百分数点）。 */
+  bond10y: number | null;
+  level_pe: ValuationLevel | null;
+  level_pb: ValuationLevel | null;
+  level_dividend: ValuationLevel | null;
+  constituents: DetailConstituent[];
+  tracker_funds: DetailTrackerFund[];
+  percentiles: DetailPercentile[];
+}
+
+/** history 接口的一个序列点。 */
+export interface ValuationHistoryPoint {
+  trade_date: string;
+  /** 指标值（PE/PB 为倍数，股息率/ERP 为百分数点）。 */
+  value: number;
+}
+
+/** history 接口映射后的数据。 */
+export interface ValuationHistoryData {
+  series: ValuationHistoryPoint[];
+  stats: PercentileSummary | null;
+}
